  <Applications>
    <Application Id="CVBuilder" Executable="CVBuilder.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="CVBuilder" Description="CV-er som rekrutterere og søknadssystemer leser riktig"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- CVBuilder.exe as a command: AI apps start the MCP bridge through it, inside the
             package, so it sees the same (redirected) data folder as the open window. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="CVBuilder.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="CVBuilder.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
